% The engine overrides this only for projects with explicit layout metadata.
\newcommand{\NFGeometrySettings}{top=23mm,bottom=23mm,left=23mm,right=23mm,headsep=5mm,footskip=10mm}
\AtBeginDocument{\expandafter\geometry\expandafter{\NFGeometrySettings}}

% Semantic notes remain native text. Their actual positions are recorded in .aux.
\RequirePackage{marginfix}
\RequirePackage[strict]{changepage}
\RequirePackage{zref-savepos}
\RequirePackage{zref-abspage}
\newcommand{\NFNoteFontSize}{9}
\newcommand{\NFNoteLeading}{13}
\newsavebox{\nfNoteBox}
\makeatletter
\zref@addprop{savepos}{abspage}
\newcommand{\nfNoteBody}[3]{%
  \fontsize{\NFNoteFontSize}{\NFNoteLeading}\selectfont
  \raggedright\setlength{\parindent}{0pt}%
  \noindent\hypertarget{note-#1}{}\zsavepos{nf-note-start-#1}%
  \hyperlink{note-ref-#1}{\textcolor{structurecolor}{\textbf{#2}}}\enspace
  #3\par\zsavepos{nf-note-end-#1}%
}
\newcommand{\nfDeclareMarginNote}[3]{%
  \expandafter\gdef\csname nf@margin@#1\endcsname{\nfNoteBody{#1}{#2}{#3}}%
}
% A margin note whose evidence block already contains its own text: place it at the note's
% own list position instead of at an nfnotemark.  Keeps a real note id for the layout report.
\newcommand{\nfPositionMarginNote}[3]{%
  \setbox\nfNoteBox=\vbox{\hsize=\marginparwidth\linewidth=\hsize
    \nfNoteBody{#1}{#2}{#3}}%
  \typeout{NFNOTE-METRIC #1 height=\number\dimexpr\ht\nfNoteBox+\dp\nfNoteBox\relax\space width=\number\wd\nfNoteBox}%
  \ifdim\dimexpr\ht\nfNoteBox+\dp\nfNoteBox\relax>\textheight
    \PackageWarning{nativeforge}{NFNOTE-OVERSIZE #1; use placement=block}%
  \fi
  \marginpar{\usebox{\nfNoteBox}}%
}
\DeclareRobustCommand{\nfnotemark}[2]{%
  \ifhmode\unskip\nobreak\fi
  \hypertarget{note-ref-#1}{}\zsavepos{nf-mark-#1}%
  \hyperlink{note-#1}{\textsuperscript{#2}}%
  \ifcsname nf@margin@#1\endcsname
    \setbox\nfNoteBox=\vbox{\hsize=\marginparwidth\linewidth=\hsize
      \csname nf@margin@#1\endcsname}%
    \typeout{NFNOTE-METRIC #1 height=\number\dimexpr\ht\nfNoteBox+\dp\nfNoteBox\relax\space width=\number\wd\nfNoteBox}%
    \ifdim\dimexpr\ht\nfNoteBox+\dp\nfNoteBox\relax>\textheight
      \PackageWarning{nativeforge}{NFNOTE-OVERSIZE #1; use placement=block}%
    \fi
    \marginpar{\usebox{\nfNoteBox}}%
  \fi
}
\xeCJKsetup{NoBreakCS+={\nfnotemark}}
\newcommand{\nfBlockNote}[3]{%
  \FloatBarrier
  \par\addvspace{0.65\baselineskip}\begingroup
  \setlength{\parskip}{0.3\baselineskip}%
  \noindent\textcolor{structurecolor}{\rule{2em}{0.4pt}}\par\nobreak
  \nfNoteBody{#1}{#2}{#3}%
  \endgroup\par\addvspace{0.65\baselineskip}%
  \FloatBarrier
}
\AtEndDocument{%
  \dumpmargins
  \ifx\mfx@marginlist\@empty\else
    \PackageWarning{nativeforge}{NF-MARGIN-QUEUE-NOT-EMPTY}%
  \fi
}
\makeatother
% Reserve the side column while native wide objects use it. No font scaling.
\newenvironment{nfFullWidth}{%
  \par\blockmargin
  \begin{adjustwidth*}{0pt}{-\dimexpr\marginparwidth+\marginparsep\relax}%
}{%
  \end{adjustwidth*}\unblockmargin\par
}

% Native Unicode glyph coverage; preserve literal code grid.
\newfontface\nfTextSymbolFont{STIXTwoMath-Regular.otf}[Scale=MatchLowercase]
\newfontface\nfMonoSymbolFont{DejaVuSansMono.ttf}[Scale=MatchLowercase]
\DeclareRobustCommand{\nfTextGlyph}[1]{\ifmmode\text{\nfTextSymbolFont\char"#1}\else{\nfTextSymbolFont\char"#1}\fi}
\DeclareRobustCommand{\nfMonoGlyph}[1]{\makebox[\fontcharwd\font"20][c]{{\nfMonoSymbolFont\char"#1}}}
\fvset{codes*={\catcode"2295=\active},defineactive*={\begingroup\lccode`\~="2295\lowercase{\endgroup\def~}{\nfMonoGlyph{2295}}}}
\AddToHook{begindocument/end}{%
\let\nfOriginalCheckmark\checkmark
\DeclareRobustCommand{\checkmark}{\ensuremath{\nfOriginalCheckmark}}
\renewcommand{\mathbf}[1]{\symbfup{#1}}
}

