\renewcommand{\arraystretch}{1.18}
\clubpenalty=10000
\widowpenalty=10000
\displaywidowpenalty=10000
\hypersetup{colorlinks=true,linkcolor=structurecolor,citecolor=structurecolor,urlcolor=structurecolor}
\makeatletter
\setlength{\@fptop}{0pt}
